# Copy to .env.local (git-ignored) and fill in. NEVER commit real values.
#
# The portal CSS API base URL, no trailing slash.
CSS_PORTAL_BASE_URL=
# The service key, in the form <id>.<secret>. It is issued by the portal; keep
# it only in .env.local or the host's environment. Server-side only: never
# prefix it with NEXT_PUBLIC_.
CSS_PORTAL_SERVICE_KEY=
# CSS's own PostgreSQL database, as a connection string
# (postgresql://user:password@host:5432/dbname). Server-side only. See
# db/README.md.
DATABASE_URL=
