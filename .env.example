# Copy to .env.local (git-ignored) and fill in. NEVER commit real values.
#
# The portal CSS API base URL, no trailing slash.
CSS_PORTAL_BASE_URL=
# The service key, in the form <id>.<secret>. It is issued by the portal; keep
# it only in .env.local or the host's environment. Server-side only: never
# prefix it with NEXT_PUBLIC_.
CSS_PORTAL_SERVICE_KEY=
# CSS's own PostgreSQL database, as a connection string
# (postgresql://user:password@host:5432/dbname). Server-side only. See
# db/README.md.
DATABASE_URL=
# CSS's own public origin (scheme + host, no trailing slash), used ONLY to build
# the deep link back to a complaint that is sent to the staff portal as a task's
# sourceUrl. Do not hardcode the host. In dev this is http://localhost:3000; in
# production it is https://frontdesk.graceonlyestates.com. Leave blank and the
# task simply carries no link.
CSS_PUBLIC_ORIGIN=
# The STAFF PORTAL (a different system from the client portal above). Used by the
# "Assign to staff" action on a complaint to create a task via its team:* API.
# This is the staff portal's ORIGIN only, no trailing slash and NO path (CSS adds
# the /api/team/v1/... path itself). Dev: http://localhost:3002
STAFF_PORTAL_BASE_URL=
# The staff portal's service key for X-Service-Key. This is the TEAM key, NOT
# CSS_PORTAL_SERVICE_KEY — copy the value from the staff portal's own .env.local.
# Server-side only: never prefix it with NEXT_PUBLIC_.
TEAM_SERVICE_KEY=
